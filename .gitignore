# Secrets and patient data must never be committed
/secrets/
/data/
*.key
*.rushd
*.backup
# Android signing keys (an app update must be signed with the same key - back it up, never commit it)
*.p12
*.jks
*.keystore
*.pass
.env
.env.*
!.env.example

