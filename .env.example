# ---- copy to .env and fill in; never commit .env ----

# Public name of the server (Caddy gets the HTTPS certificate for it)
RUSHD_DOMAIN=rx.example.com

# Claude API key from https://console.anthropic.com (needed for cloud reading)
ANTHROPIC_API_KEY=

# Optional tuning
# RUSHD_AI_MODEL=claude-opus-5-5        # or claude-sonnet-5-5 for about half the cost
# RUSHD_AI_EFFORT=medium
# RUSHD_WORKER_THREADS=2
# RUSHD_SESSION_IDLE_MINUTES=30
# RUSHD_LOCAL_BASE_MODEL=Qwen/Qwen2-VL-2B-Instruct
